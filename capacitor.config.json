{
  "appId": "com.acepilotacademy.app",
  "appName": "Ace Pilot Academy",
  "webDir": "www",
  "server": {
    "url": "https://app.acepilotacademy.com",
    "cleartext": false,
    "iosScheme": "https"
  },
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#2C3E54",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
